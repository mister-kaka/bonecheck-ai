# API
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# Интерфейс
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000

# ML-компонент. Порт хоста для контейнера. Браузер этот порт не открывает.
ML_SERVICE_PORT=8000
# Адрес долгоживущего inference для локального API вне Docker.
ML_SERVICE_URL=http://127.0.0.1:8000
# Таймаут одного вызова site_prediction, миллисекунды.
ML_TIMEOUT_MS=180000

# Каталог DICOM. Путь относительно каталога, из которого запущен API.
UPLOAD_DIR=./uploads

# Файл метаданных исследований. Путь относительно каталога, из которого запущен API.
# В Docker Compose используется /app/data/bonecheck-docker.sqlite
DATABASE_PATH=./data/bonecheck.sqlite
