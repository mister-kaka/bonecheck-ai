# Backend (NestJS)
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# Frontend (Vite)
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000

# ML service (Python placeholder)
ML_SERVICE_PORT=8000

# Backend file storage (DICOM на диск, не в PostgreSQL)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=52428800
ML_MOCK_DELAY_MS=300

# PostgreSQL пока не подключена (in-memory хранилище метаданных).
# Когда инфраструктура будет готова:
# DATABASE_URL=postgresql://ruen:ruen@localhost:5432/ruen
