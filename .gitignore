# Окружение
.env
.env.local
.env.*.local

# Node.js
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
.npm

# Интерпретатор Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Чекпоинты вне ml/models не коммитить. Веса в ml/models входят в репозиторий.
*.pt
*.pth
*.onnx
*.ckpt
*.h5
!ml/models/**/*.pt
!ml/models/**/*.pth

# Датасеты (медицинские данные не коммитить)
data/
datasets/
*.dcm
*.zip

# Загруженные исследования (локальные файлы, не база)
/uploads/
backend/uploads/*
!backend/uploads/.gitkeep

# Локальный SQLite (файл метаданных MVP; не коммитить)
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db

# Редакторы и система
.idea/
.vscode/
.DS_Store
Thumbs.db

# Журналы Docker
*.log
