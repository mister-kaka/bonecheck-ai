# Бэкенд (NestJS)
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# Фронтенд (Vite)
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000

# Сервис ML (заглушка на Python)
ML_SERVICE_PORT=8000

# Хранение файлов бэкенда (DICOM на диск, не в базе)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=52428800
ML_MOCK_DELAY_MS=300

# SQLite: локальный файл метаданных. Каталог создаётся при старте.
# Путь относительно cwd процесса backend (обычно каталог backend/).
# В Docker Compose путь задан отдельно: /app/data/bonecheck.sqlite
DATABASE_PATH=./data/bonecheck.sqlite
